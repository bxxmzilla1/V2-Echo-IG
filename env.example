# Local: copy to .env.local. Vercel: Project → Settings → Environment Variables (Production + Preview)
GEMINI_API_KEY=

# IPinfo: optional. Enables (country) and (city) in the bio. https://ipinfo.io/
VITE_IPINFO_TOKEN=

# Supabase: publish to /{path}, storage for uploads. See supabase/schema.sql
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. After running `node scripts/upload-ig-logo.mjs`, paste the printed public URL
# (loads the loading-screen logo from Supabase Storage instead of /ig-logo.jpg).
# VITE_IG_LOGO_URL=
